{
    "manifest_version": 3,
    "name": "Primal ADBlocker",
    "description": "A primitive youtube AD blocker",
    "version": "2.0.0",
    "icons": 
    {
        "16": "./16x16.png",
        "32": "./32x32.png",
        "48": "./48x48.png",
        "128": "./128x128.png"
    },
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "options.html"
    },
    "permissions": ["tabs"],
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"],
        "js": ["content.js"]
      }
    ]
  }
  